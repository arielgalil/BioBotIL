rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Config: App needs to read billing to check budget. No one should write.
    match /config/billing {
      allow get: if true;
      allow list: if false;
      allow write: if false; // ONLY Cloud Functions can write
    }

    // Stats: Now updated by Cloud Functions. Clients can only read.
    match /stats/global {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Users: Profiles are now updated by Cloud Functions.
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Activity Logs: Clients can ONLY create logs. They cannot read or modify them.
    match /activity_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
